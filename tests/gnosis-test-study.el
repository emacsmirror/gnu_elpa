           (labels (mapcar #'car candidates)))
      (should (equal "unique-id" (cdr (assoc "Καρδιολογία" candidates))))
      (should (equal "literal-id" (cdr (assoc "Same title — fixture.org" candidates))))
      (should (= 4 (length (delete-dups (copy-sequence labels)))))
      (dolist (label labels)
