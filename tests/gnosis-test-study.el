(defun gnosis-test-study-action-owner-case (mode action boundary)
  "Exercise MODE ACTION after database replacement at BOUNDARY.
Use real pending answers and writers with accepted evidence in both databases."
  (gnosis-test-study
    (gnosis-test-study-view-fixture "A encountered")
    (gnosis-study-flag 42 t)
    (gnosis-test-study-summary '(42 43) 'due)
    (gnosis-test-study-summary '(42 43) 'practice)
    (let ((original gnosis-db) (directory gnosis-dir)
          (gnosis-review-basic-input 'typed))
      (gnosis-test-with-db
        (gnosis-test-study-view-fixture "B unrelated")
        (gnosis-study-flag 42 t)
        (gnosis-test-study-summary '(42 43) 'due)
        (gnosis-test-study-summary '(42 43) 'practice)
        (let ((other gnosis-db) (other-directory gnosis-dir)
              (other-before (gnosis-test-study-view-snapshot)) before termination)
          (let ((gnosis-db original) (gnosis-dir directory))
            (cl-letf (((symbol-function 'gnosis--read-string-with-input-method)
                       (lambda (&rest _) "Answer"))
                      ((symbol-function 'read-char-choice)
                       (lambda (&rest _)
                         (if before (signal 'quit nil)
                           (setq before (gnosis-test-study-view-snapshot))
                           (when (eq boundary 'action)
                             (setq gnosis-db other gnosis-dir other-directory))
                           action)))
                      ((symbol-function 'y-or-n-p)
                       (lambda (&rest _)
                         (when (eq boundary 'confirmation)
                           (setq gnosis-db other gnosis-dir other-directory))
                         t)))
              (condition-case err (gnosis-review-loop '(42) mode)
                ((error quit) (setq termination (car err))))))
          (should before)
          (should (equal other-before (gnosis-test-study-view-snapshot)))
          (let ((gnosis-db original) (gnosis-dir directory))
            (should (equal before (gnosis-test-study-view-snapshot)))
            (should (equal '(42) (gnosis-review-state-remaining (gnosis-review--read-session)))))
          (should (memq termination '(user-error gnosis-review-content-changed))))))))

