(ert-deftest gnosis-study-real-practice-finite-tail-and-no-rescheduling ()
  (gnosis-test-study
    (let* ((a (gnosis-test--add-basic-thema "Q1" "A1"))
           (b (gnosis-test--add-basic-thema "Q2" "A2"))
           (before (gnosis-test-study-snapshot))
           (answers '("wrong" "A2" "wrong"))
           (calls 0) state)
      (cl-letf (((symbol-function 'gnosis--read-string-with-input-method)
                 (lambda (&rest _) (pop answers)))
                ((symbol-function 'read-char-choice) (lambda (&rest _) ?n)))
        (setq state (gnosis-review-loop (lambda () (cl-incf calls) (list a b a)) 'practice)))
      (should (= 1 calls))
      (should-not answers)
      (should (equal before (gnosis-test-study-snapshot)))
      (should (= 3 (length (gnosis-select '* 'practice-events))))
      (should (equal (list a b a) (gnosis-select 'thema-id 'practice-events nil t)))
      (should (equal '(:selected 2 :unique 2 :attempts 3 :first-success 1 :first-failure 1
                       :retry-success 0 :retry-failure 1 :needs-work 1 :excluded 0 :unattempted 0)
                     (gnosis-review-summary state)))
      (should-not (gnosis-review-state-remaining (gnosis-review--read-session))))))

(ert-deftest gnosis-study-self-grade-reveal-both-modes-and-override ()
  (gnosis-test-study
    (dolist (mode '(practice due))
      (dolist (grade '(?y ?n))
        (let* ((id (gnosis-test--add-basic-thema "Explain mechanism" "Secret checklist" nil "Secret explanation"))
               (gnosis-review-basic-input 'self-grade)
               (before (gnosis-test-study-snapshot))
               (source (generate-new-buffer "*secret source*"))
               (keys (list ?\s grade ?o ?q))
               (checks 0))
          (with-current-buffer source (insert "Secret checklist"))
          (switch-to-buffer source)
          (delete-other-windows)
          (split-window-right)
          (cl-letf (((symbol-function 'read-char-choice)
                     (lambda (prompt &rest _)
                       (when (string-prefix-p "Recall first" prompt)
                         (cl-incf checks)
                         (should-not (get-buffer-window source))
                         (should-not (string-match-p "Secret" (buffer-string))))
                       (when (string-prefix-p "Recalled" prompt)
                         (should (string-match-p "Secret checklist" (buffer-string)))
                         (should (string-match-p "Secret explanation" (buffer-string))))
                       (pop keys))))
            (gnosis-review-loop (list id) mode))
          (should (= checks 1))
          (should (= 1 (gnosis-review-state-reviewed (gnosis-review--read-session))))
          (if (eq mode 'practice)
              (progn (should (equal before (gnosis-test-study-snapshot)))
                     (should (= (if (= grade ?y) 1 3)
                                (gnosis-get 'rating 'practice-events `(= thema-id ,id)))))
            (should (= (if (= grade ?y) 1 3)
                       (gnosis-get 'rating 'review-events `(= thema-id ,id)))))
          ;; Quit after a failure retains a retry; discard only the batch.
          (gnosis--delete 'study-session))))))

(ert-deftest gnosis-study-cancel-before-reveal-and-after-reveal ()
  (gnosis-test-study
    (dolist (reveal '(nil t))
      (let* ((id (gnosis-test--add-basic-thema "Q" "Answer"))
             (gnosis-review-basic-input 'self-grade)
             (before (gnosis-test-study-snapshot))
             (calls 0))
        (cl-letf (((symbol-function 'read-char-choice)
                   (lambda (&rest _) (cl-incf calls)
                     (if (and reveal (= calls 1)) ?\s (signal 'quit nil)))))
          (should (eq 'cancelled (condition-case nil (gnosis-review-loop (list id) 'practice)
                                   (quit 'cancelled)))))
        (should (equal before (gnosis-test-study-snapshot)))
        (should-not (gnosis-select '* 'practice-events))
        (should (equal (list id) (gnosis-review-state-remaining (gnosis-review--read-session))))
        (gnosis--delete 'study-session)))))

(ert-deftest gnosis-study-mid-session-removal-and-new-authoring ()
  (gnosis-test-study
    (let* ((a (gnosis-test--add-basic-thema "A" "a"))
           (b (gnosis-test--add-basic-thema "B" "b"))
           (c (gnosis-test--add-basic-thema "C" "c")) state)
