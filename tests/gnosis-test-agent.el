;;; gnosis-test-agent.el --- Native agent handoff regressions -*- lexical-binding: t; -*-

(require 'ert)
(require 'json)
(require 'gnosis-agent)
(require 'gnosis-test-helpers)
(require 'gnosis-test-schema-v8)

(defmacro gnosis-test-agent (&rest body)
  "Run BODY with isolated data, UI and deterministically captured timers."
  (declare (indent 0) (debug t))
  `(gnosis-test-with-db
     (let ((buffers (buffer-list))
           (gnosis-agent--launches nil)
           (gnosis-review--running nil)
           (gnosis-review-buffer-name "*Gnosis Agent Test*")
           (gnosis-review-basic-input 'typed)
           (gnosis-monkeytype-enable nil)
           (gnosis-center-content nil)
           (register-alist nil))
       (save-window-excursion
         (unwind-protect
             (cl-letf (((symbol-function 'run-with-timer) (lambda (&rest _) nil)))
                      ,@body)
           (mapc #'gnosis-agent--release (copy-sequence gnosis-agent--launches))
           (dolist (buffer (seq-difference (buffer-list) buffers))
             (when (buffer-live-p buffer)
               (with-current-buffer buffer (set-buffer-modified-p nil))
               (kill-buffer buffer))))))))

(defun gnosis-test-agent-start (ids &optional policy)
  "Start practice for IDS and optional POLICY, returning its identity."
  (plist-get (gnosis-agent-start-practice :thema-ids ids :limit (length ids) :policy policy)
             :session-id))

(defun gnosis-test-agent-grade (success)
  "Accept SUCCESS through the real core for the current queued thema."
  (let* ((gnosis-review--state (gnosis-review--read-session))
         (id (car (gnosis-review-state-remaining gnosis-review--state))))
    (gnosis-review-result id success (gnosis-review-algorithm id success))))

(defun gnosis-test-agent-snapshot ()
  "Return every scheduling authority row, including nonempty evidence."
  (mapcar (lambda (table) (gnosis-select '* table))
          '(scheduler-config scheduler-active scheduler-baseline scheduler-state
                             review-events review-voids review-activity-baseline)))

(ert-deftest gnosis-agent-policy-validation-and-streak ()
  (let ((policy (gnosis-review-practice-policy)))
    (should (equal policy '(:successes-required 1 :successes-after-failure 2
                                                :consecutive t :max-attempts-per-thema 5)))
    (should (equal "target-reached" (plist-get (gnosis-review-policy-progress policy '(t)) :reason)))
    (should (equal "unfinished" (plist-get (gnosis-review-policy-progress policy '(t nil t nil)) :reason)))
    (should (equal "attempt-limit" (plist-get (gnosis-review-policy-progress policy '(t nil t nil nil)) :reason)))
    (should (equal "target-reached" (plist-get (gnosis-review-policy-progress policy '(t t nil t nil)) :reason)))
    (should (equal "target-reached" (plist-get (gnosis-review-policy-progress
                                                (gnosis-review-practice-policy '(:consecutive nil))
                                                '(t nil t nil)) :reason)))
    (dolist (bad '((:unknown 1) (:successes-required 0) (:successes-after-failure -1)
                   (:max-attempts-per-thema 2.0) (:consecutive yes)
                   (:consecutive t :consecutive nil) (:consecutive) (a . b)))
      (should-error (gnosis-review-practice-policy bad) :type 'user-error))))

(ert-deftest gnosis-agent-selection-limit-empty-and-json ()
  (gnosis-test-agent
    (gnosis-test--add-basic-thema "A" "a" nil nil 101)
    (gnosis-test--add-basic-thema "B" "b" nil nil 102)
    (gnosis-test--add-basic-thema "C" "c" nil nil 103 1)
    (let* ((status (gnosis-agent-start-practice :thema-ids '(103 102 101 101 999) :limit 1))
           (id (plist-get status :session-id)))
      (should (equal "pending" (plist-get status :status)))
      (should (equal [101] (plist-get status :selected-ids)))
      (should (= 1 (plist-get (plist-get status :selection) :omitted-by-limit)))
      (should (equal [103 999] (plist-get (plist-get status :selection) :excluded-ids)))
      (should-not (gnosis-select '* 'practice-events))
      (should-not (get-buffer gnosis-review-buffer-name))
      (let ((json (json-serialize (gnosis-agent-results id) :false-object :false :null-object nil)))
        (should (string-match-p "\"schedule-updated\":false" json))
        (should (string-match-p "\"events\":\\[\\]" json))
        (should (string-match-p "\"deleted\":false" json)))
      (gnosis-agent-cancel id))
    (let* ((status (gnosis-agent-start-practice :thema-ids '(103 999) :limit 4))
           (id (plist-get status :session-id)))
      (should (equal "completed" (plist-get status :status)))
      (should (= 4 (plist-get (plist-get status :selection) :shortfall)))
      (should (equal [] (plist-get (gnosis-agent-results id) :items))))
    (dolist (args '((:thema-ids (101)) (:thema-ids (101) :limit 0)
                    (:thema-ids (101) :topic-ids ("topic") :limit 1)
                    (:thema-ids ("101") :limit 1) (:topic-ids (42) :limit 1)
                    (:thema-ids (101 . 102) :limit 1)))
      (should-error (apply #'gnosis-agent-start-practice args) :type 'user-error))))

