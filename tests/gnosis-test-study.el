(ert-deftest gnosis-study-nodes-file-association-retires-fresh-commands ()
  (dolist (key '("p" "r" "S" "a" "R"))
    (dolist (detach '(t nil))
      (dolist (marked '(t nil))
        (dolist (replace-text '(t nil))
          (gnosis-test-study
            (let ((gnosis-dashboard-buffer-name " *Gnosis node ownership*"))
              (gnosis-test-study-view-fixture "Displayed")
              (gnosis-test-study-summary '(43 42) 'due)
              (gnosis-test-study-summary '(43 42) 'practice)
              (gnosis-test-study-nodes-open)
              (when marked
                (call-interactively (key-binding (kbd "m"))))
              (let ((before (gnosis-test-study-view-snapshot)))
                (set-visited-file-name
                 (expand-file-name "successor.txt" gnosis-dir) t)
                (when detach (set-visited-file-name nil t))
                (when replace-text
                  (let ((inhibit-read-only t))
                    (erase-buffer)
                    (insert "Unsaved successor λ")))
                (let ((buffer (current-buffer)) (text (buffer-string))
                      (file buffer-file-name) (modified (buffer-modified-p))
                      (position (point)))
                  (cl-letf (((symbol-function 'read-number)
                             (lambda (&rest _) (ert-fail "Retired view prompted for depth")))
                            ((symbol-function 'y-or-n-p)
                             (lambda (&rest _) (ert-fail "Retired view prompted to launch"))))
                    ;; Resolve a fresh binding after both native transitions.
                    (should-error (call-interactively (key-binding (kbd key)))
                                  :type 'user-error))
                  (should (eq buffer (current-buffer)))
                  (should (equal text (buffer-string)))
                  (should (equal file buffer-file-name))
                  (should (eq modified (buffer-modified-p)))
                  (should (= position (point))))
                (should-not gnosis-dashboard--selected-ids)
                (should (equal before (gnosis-test-study-view-snapshot)))))))))))

