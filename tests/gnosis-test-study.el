(ert-deftest gnosis-study-grade-checkpoint-atomic-failure-retry-and-reopen ()
  (gnosis-test-study
    (dolist (mode '(due practice))
      (let* ((id (gnosis-test--add-basic-thema "Q" "A"))
             (buf (gnosis-test-study-state (list id) mode))
             (before (gnosis-test-study-snapshot)))
        (with-current-buffer buf
          (let ((pending (gnosis-review-algorithm id t))
                (saved (gnosis-get 'data 'study-session '(= id 1))))
            (cl-letf (((symbol-function 'gnosis-review--save-session)
                       (lambda (_) (error "Injected checkpoint failure"))))
              (should-error (gnosis-review-result id t pending)))
            (should (equal saved (gnosis-get 'data 'study-session '(= id 1))))
            (should (equal before (gnosis-test-study-snapshot)))
            (should-not (gnosis-select '* 'practice-events))
            (let ((real (symbol-function 'gnosis-review--write-result)) (calls 0))
              (cl-letf (((symbol-function 'gnosis-review--write-result)
                         (lambda (&rest args)
                           (cl-incf calls)
                           (if (= calls 1) (error "Transient write failure") (apply real args))))
                        ((symbol-function 'y-or-n-p) (lambda (&rest _) t)))
                (gnosis-review--accept id t pending))
              (should (= calls 2)))
            (gnosis-review-result id t pending)
            (should (= 1 (gnosis-review-state-reviewed gnosis-review--state)))
            (gnosis-sqlite-close gnosis-db)
            (setq gnosis-db (gnosis-sqlite-open gnosis-test--db-file))
            (gnosis-db-init)
            (should-not (gnosis-review-state-remaining (gnosis-review--read-session)))
            (should (= 1 (gnosis-review-state-reviewed (gnosis-review--read-session))))))
      (gnosis--delete 'study-session)))))

(ert-deftest gnosis-study-undo-preserves-evidence-and-reanswers ()
  (gnosis-test-study
    (dolist (mode '(practice due))
      (let* ((id (gnosis-test--add-basic-thema "Q" "A"))
             (buf (gnosis-test-study-state (list id) mode))
             (before (gnosis-test-study-snapshot)))
        (with-current-buffer buf
          (let* ((pending (gnosis-review-algorithm id nil)) event correction)
            (gnosis-review-result id nil pending)
            (let ((slot (gnosis-review-state-undo gnosis-review--state)))
              (setq event (plist-get slot :event-id) correction (plist-get slot :correction-id)))
            (gnosis-toggle-suspend-themata (list id) 1 t)
            (setq gnosis-review--state (gnosis-review-undo event correction))
            (gnosis-review-undo event correction)
            (should (gnosis-suspended-p id))
            (should (= 0 (gnosis-review-state-reviewed gnosis-review--state)))
            (should-error (gnosis-review-result id nil pending))
            (should-not (equal event (gnosis-review-state-event-id gnosis-review--state)))
            (gnosis-toggle-suspend-themata (list id) 0 t)
            (let ((next (gnosis-review-algorithm id t)))
              (gnosis-review-result id t next))
            (should (= 1 (gnosis-review-state-reviewed gnosis-review--state)))
            (if (eq mode 'practice)
                (should (equal before (gnosis-test-study-snapshot)))
              (should (= 1 (gnosis-get 'reps 'scheduler-state `(= thema-id ,id))))
              (should (= 2 (length (gnosis-select '* 'review-events `(= thema-id ,id)))))
              (should (= 1 (plist-get (gnosis-scheduler-replay-thema id 0) :reps))))))
      (gnosis--delete 'study-session)))))

(ert-deftest gnosis-study-retention-versioning-preview-race-and-replay ()
  (gnosis-test-study
    (let* ((id (gnosis-test--add-basic-thema "Q" "A"))
           (gnosis-review--state nil)
           (pending (gnosis-review-algorithm id t))
           (before (gnosis-test-study-snapshot)))
      (dolist (invalid '(0 1 -1 2 "0.9" 0.0e+NaN 1.0e+INF))
        (should-error (gnosis-scheduler-set-retention invalid)))
      (should (equal before (gnosis-test-study-snapshot)))
      (let ((new (gnosis-scheduler-set-retention 0.95)))
        (should (= new (gnosis-scheduler-set-retention 0.95)))
        (should-error (gnosis-review-result id t pending))
        (should (= 0 (gnosis-get 'reps 'scheduler-state `(= thema-id ,id))))
        (let ((pending (gnosis-review-algorithm id t))) (gnosis-review-result id t pending))
        (should (= new (gnosis-get 'config-id 'review-events `(= thema-id ,id))))
        (should (= new (gnosis-get 'config-id 'scheduler-state `(= thema-id ,id))))
        (gnosis-scheduler-set-retention 0.8)
        (let ((pending (gnosis-review-algorithm id t))) (gnosis-review-result id t pending))
        (should (= 2 (plist-get (gnosis-scheduler-replay-thema id 0) :reps)))
        (let ((new-id (gnosis-test--add-basic-thema "New" "Answer")))
          (should (= (gnosis-scheduler-active-config)
                     (gnosis-get 'config-id 'scheduler-state `(= thema-id ,new-id)))))
        (gnosis-sqlite-close gnosis-db)
        (setq gnosis-db (gnosis-sqlite-open gnosis-test--db-file))
        (should (= 0.8 (gnosis-scheduler--config-retention gnosis-db (gnosis-scheduler-active-config))))))))

(ert-deftest gnosis-study-backup-keeps-evidence-content-export-does-not ()
  (gnosis-test-study
    (let* ((id (gnosis-test--add-basic-thema "Q" "A" '("needs_work")))
           (buf (gnosis-test-study-state (list id) 'practice))
           (backup (expand-file-name "full.db" gnosis-dir))
           (content (expand-file-name "content.gnosis" gnosis-dir)))
      (with-current-buffer buf (gnosis-review-result id t (gnosis-review-algorithm id t)))
      (gnosis-backup-db backup)
      (should-error (gnosis-backup-db backup))
      (let ((copy (gnosis-sqlite-open backup)))
        (unwind-protect
            (progn
              (should (equal (gnosis-select '* 'practice-events)
                             (gnosis-sqlite-select copy "SELECT * FROM practice_events")))
              (should (equal (gnosis-select '* 'study-session)
                             (gnosis-sqlite-select copy "SELECT * FROM study_session"))))
          (gnosis-sqlite-close copy)))
      (gnosis-export-db content nil nil t)
      (let ((copy (gnosis-sqlite-open content)))
        (unwind-protect
            (progn (should-not (sqlite-select copy "SELECT name FROM sqlite_master WHERE name = 'practice_events'"))
                   (should (equal '(("needs_work")) (gnosis-sqlite-select copy "SELECT tag FROM thema_tag"))))
          (gnosis-sqlite-close copy))))))

