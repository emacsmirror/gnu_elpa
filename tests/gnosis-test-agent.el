(ert-deftest gnosis-agent-policy-undo-and-history-atomicity ()
  (gnosis-test-agent
    (gnosis-test--add-basic-thema "A" "a" nil nil 101)
    (let* ((policy (list :successes-required 2))
           (session (gnosis-test-agent-start '(101) policy)))
      (setcar (cdr policy) 99)
      (gnosis-test-agent-grade nil)
      (gnosis-test-agent-grade t)
      (let ((before (gnosis-agent-results session))
            (state (gnosis-review--state-data (gnosis-review--read-session))))
        (cl-letf (((symbol-function 'gnosis-review--save-history) (lambda (_) (error "History disk fault"))))
          (should-error (gnosis-test-agent-grade t))
          (should-error (gnosis-review-undo)))
        (should (equal before (gnosis-agent-results session)))
        (should (equal state (gnosis-review--state-data (gnosis-review--read-session))))
        (should-not (gnosis-select '* 'practice-voids)))
      (gnosis-review-undo)
      (let* ((result (gnosis-agent-results session))
             (events (plist-get (aref (plist-get result :items) 0) :events)))
        (should (= 2 (length events)))
        (should (eq :false (plist-get (aref events 1) :effective)))
        (should (stringp (plist-get (aref events 1) :correction-id)))
        (should (= 0 (plist-get (plist-get result :summary) :retry-success))))
      (gnosis-test-agent-grade t)
      (should (gnosis-review-state-remaining (gnosis-review--read-session)))
      (gnosis-test-agent-grade t)
      (should (equal "completed" (plist-get (gnosis-agent-results session) :status)))
      (should (= 2 (plist-get (plist-get (gnosis-agent-status session) :policy) :successes-required)))
      (should (= 4 (length (gnosis-select '* 'practice-events)))))))

