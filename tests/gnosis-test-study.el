(ert-deftest gnosis-study-post-commit-projection-failure-retry ()
  (gnosis-test-study
    (dolist (mode '(due practice))
      (let* ((id (gnosis-test--add-basic-thema "Q" "A"))
             (buf (gnosis-test-study-state (list id) mode)))
        (with-current-buffer buf
          (let ((pending (gnosis-review-algorithm id nil))
                (read-session (symbol-function 'gnosis-review--read-session))
                (calls 0))
            (cl-letf (((symbol-function 'gnosis-review--read-session)
                       (lambda ()
                         (if (= (cl-incf calls) 2)
                             (error "Reply lost after commit")
                           (funcall read-session)))))
              (should-error (gnosis-review-result id nil pending)))
            (should (= 0 (gnosis-review-state-reviewed gnosis-review--state)))
            (let ((saved (gnosis-get 'data 'study-session '(= id 1))))
              (should (= 1 (plist-get saved :reviewed)))
              (gnosis-scheduler-set-retention 0.95)
              ;; A retained retry ignores later configuration changes.
              (gnosis-review-result id nil pending)
              (should (equal saved (gnosis-get 'data 'study-session '(= id 1)))))
            (should (= 1 (gnosis-review-state-reviewed gnosis-review--state)))
            (should (equal (list id) (gnosis-review-state-requeued gnosis-review--state)))
            (should (equal (list id) (gnosis-review-state-remaining gnosis-review--state)))
            (should (= 1 (length (gnosis-select '* (if (eq mode 'due) 'review-events 'practice-events)
                                                 `(= thema-id ,id)))))
            (should (gnosis-review-state-undo gnosis-review--state))))))))

