(defmacro gnosis-test-study (&rest body)
  "Run BODY with real writers and disposable buffers and database."
  (declare (indent 0) (debug t))
  `(gnosis-test-with-db
     (let ((buffers (buffer-list))
           (gnosis-review-buffer-name "*Gnosis Test Recall*")
           (gnosis-monkeytype-enable nil)
           (gnosis-center-content nil)
           (register-alist nil))
       (save-window-excursion
         (unwind-protect (progn ,@body)
           (dolist (buf (seq-difference (buffer-list) buffers))
             (when (buffer-live-p buf)
               (with-current-buffer buf (set-buffer-modified-p nil))
               (kill-buffer buf))))))))

(defun gnosis-test-study-snapshot ()
  "Snapshot every scheduling authority and activity row."
  (mapcar (lambda (table) (gnosis-sqlite-select gnosis-db
                           (format "SELECT * FROM %s ORDER BY 1" table)))
          '(scheduler_config scheduler_active scheduler_baseline scheduler_state
            review_events review_voids review_activity_baseline)))

(defun gnosis-test-study-node (id &optional title)
  "Insert node ID with TITLE into the disposable index."
  (gnosis--insert-into 'nodes `([,id "fixture.org" ,(or title "Same title") "1" nil nil nil])))

(defun gnosis-test-study-state (ids mode)
  "Create a persisted session for IDS in MODE, returning its buffer."
  (let ((buf (gnosis-review--setup-buffer ids mode)))
    (with-current-buffer buf
      (setf (gnosis-review-state-persistent-p gnosis-review--state) t)
      (gnosis-review--save-session gnosis-review--state))
    buf))

(ert-deftest gnosis-study-selection-identity-cycle-and-composition ()
  (gnosis-test-study
    (gnosis-test-study-node "one")
    (gnosis-test-study-node "two")
    (gnosis--insert-into 'node-links '(["one" "two"] ["two" "one"]))
    (let* ((a (gnosis-test--add-basic-thema "due" "a"))
           (b (gnosis-test--add-basic-thema "future" "b"))
           (c (gnosis-test--add-basic-thema "suspended" "c" nil nil nil 1))
           (gnosis-new-themata-limit 0))
      (gnosis-update 'scheduler-state `(= due-day ,(gnosis--date-to-int (gnosis-date 3))) `(= thema-id ,b))
      (gnosis--insert-into 'thema-links `([,a "one"] [,a "two"] [,b "two"] [,c "one"]))
      (should (= 2 (length (gnosis-study-topic-candidates))))
      (should (equal '("one" "two") (mapcar #'cdr (gnosis-study-topic-candidates))))
      (should (equal (list a) (gnosis-study-topic-ids '("one"))))
      (should (equal (sort (list a b) #'<) (sort (gnosis-study-topic-ids '("one") nil 8 8) #'<)))
      (should (equal (list a) (gnosis-study-topic-ids '("one" "two") t)))
      (should (equal '(:total 2 :eligible 2 :suspended 0 :new 2 :due 1 :not-due 1)
                     (gnosis-study-composition (list a b a))))
      (cl-letf (((symbol-function 'completing-read-multiple)
                 (lambda (_ candidates &rest _) (mapcar #'car candidates))))
        (should (equal '("one" "two") (gnosis-study-read-topics))))
      (should-error (gnosis-study-topic-ids '("one") nil -1)))))

(ert-deftest gnosis-study-topic-labels-hide-ids-and-preserve-identity ()
