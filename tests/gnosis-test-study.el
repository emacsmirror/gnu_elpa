(ert-deftest gnosis-study-repair-binding-save-cancel-and-draft ()
  (dolist (source-kind '(standalone unindexed linked))
    (gnosis-test-study
      (let* ((gnosis-save-hook nil)
             (gnosis-review-editing-p nil)
             (gnosis-nodes-dir gnosis-dir)
             (org-id-track-globally nil)
             (context (if (eq source-kind 'standalone) ""
                        "[[id:source][Source]]"))
             (id (gnosis-test--add-basic-thema "Original wording" "Answer"
                                               '("needs_work") context))
             (file (expand-file-name "source.org" gnosis-dir))
             (source-text "#+title: Source\n* Source\n:PROPERTIES:\n:ID: source\n:END:\nSource passage\n"))
        (unless (eq source-kind 'standalone)
          (gnosis--insert-into 'thema-links `([,id "source"])))
        (when (eq source-kind 'linked)
          (with-temp-file file (insert source-text))
          (gnosis-nodes-update-file file))
        ;; Nonempty retained evidence makes deletion as well as writes visible.
        (gnosis-scheduler-accept-review (gnosis-scheduler-event-id) id
                                       'failure 1 20260901)
        (with-current-buffer (gnosis-test-study-state (list id) 'practice)
          (gnosis-review-result id nil (gnosis-review-algorithm id nil)))
        (let ((before (gnosis-test-study-snapshot))
              (practice (gnosis-select '* 'practice-events))
              (voids (gnosis-select '* 'practice-voids))
              (session (gnosis-select '* 'study-session)))
          (gnosis-study-repair)
          (goto-char (point-min))
          (should (equal id (tabulated-list-get-id)))
          (let ((repair (current-buffer)))
            (unless (eq source-kind 'linked)
              (should (equal '(user-error "No indexed source for this thema")
                             (should-error
                              (call-interactively (key-binding (kbd "v")))
                              :type 'user-error))))
            (call-interactively (key-binding (kbd "RET")))
            (should (derived-mode-p 'gnosis-edit-mode))
            (should (equal "*Gnosis Edit*" (buffer-name)))
            (when (eq source-kind 'linked)
              (should (get-buffer-window (get-file-buffer file)))
              (should (equal source-text
                             (with-current-buffer (get-file-buffer file)
                               (buffer-string)))))
            (delete-region (line-beginning-position) (line-end-position))
            (insert "Clearer wording")
            (let ((editor (current-buffer))
                  (draft (buffer-string))
                  (register (get-register :gnosis-edit)))
              (switch-to-buffer repair)
              (should-error (call-interactively (key-binding (kbd "RET")))
                            :type 'user-error)
              (should (eq (current-buffer) repair))
              (should (equal draft (with-current-buffer editor (buffer-string))))
              (should (eq register (get-register :gnosis-edit)))
              (switch-to-buffer editor))
            (call-interactively (key-binding (kbd "C-c C-c")))
            (should (equal "Clearer wording"
                           (gnosis-get 'keimenon 'themata `(= id ,id))))
            (should (equal context (gnosis-get 'parathema 'extras `(= id ,id))))
            (should (member "needs_work" (gnosis-get-tags-for-ids (list id))))
            (should (equal before (gnosis-test-study-snapshot)))
            (should (equal practice (gnosis-select '* 'practice-events)))
            (should (equal voids (gnosis-select '* 'practice-voids)))
            (should (equal session (gnosis-select '* 'study-session)))
            (switch-to-buffer repair)
            (call-interactively (key-binding (kbd "RET")))
            (should (derived-mode-p 'gnosis-edit-mode))
            (insert "Cancelled change ")
            (call-interactively (key-binding (kbd "C-c C-k")))
            (should-not (get-buffer "*Gnosis Edit*"))
            (if (eq source-kind 'linked)
                (progn
                  (should (equal file buffer-file-name))
                  (should (equal "source" (org-entry-get nil "ID")))
                  (should (equal source-text (buffer-string)))
                  (should-not (buffer-modified-p)))
              (should (eq repair (current-buffer))))
            (should (equal "Clearer wording"
                           (gnosis-get 'keimenon 'themata `(= id ,id))))
            (should (equal context (gnosis-get 'parathema 'extras `(= id ,id))))
            (should (equal before (gnosis-test-study-snapshot)))
            (should (equal practice (gnosis-select '* 'practice-events)))
            (should (equal voids (gnosis-select '* 'practice-voids)))
            (should (equal session (gnosis-select '* 'study-session)))))))))

