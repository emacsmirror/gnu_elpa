(ert-deftest gnosis-study-backup-keeps-evidence-content-export-does-not ()
  (gnosis-test-study
    (let* ((id (gnosis-test--add-basic-thema "Q" "A" '("needs_work")))
           (buf (gnosis-test-study-state (list id) 'practice))
           (backup (expand-file-name "full.db" gnosis-dir))
           (content (expand-file-name "content.gnosis" gnosis-dir)))
      (with-current-buffer buf (gnosis-review-result id t (gnosis-review-algorithm id t)))
      (gnosis-backup-db backup)
      (should-error (gnosis-backup-db backup))
      (let ((copy (gnosis-sqlite-open backup)))
        (unwind-protect
            (progn
              (should (equal (gnosis-select '* 'practice-events)
                             (gnosis-sqlite-select copy "SELECT * FROM practice_events")))
              (should (equal (gnosis-select '* 'study-session)
                             (gnosis-sqlite-select copy "SELECT * FROM study_session"))))
          (gnosis-sqlite-close copy)))
      (gnosis-export-db content nil nil t)
      (let ((copy (gnosis-sqlite-open content)))
        (unwind-protect
            (progn (should-not (sqlite-select copy "SELECT name FROM sqlite_master WHERE name = 'practice_events'"))
                   (should (equal '(("needs_work")) (gnosis-sqlite-select copy "SELECT tag FROM thema_tag"))))
          (gnosis-sqlite-close copy))))))

