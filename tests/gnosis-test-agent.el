(ert-deftest gnosis-agent-launch-owner-mismatch-and-quit-containment ()
  (gnosis-test-agent
    (gnosis-test--add-basic-thema "A" "a" nil nil 101)
    (let ((session (gnosis-test-agent-start '(101))))
      (let ((record (car gnosis-agent--launches)) (gnosis-db nil))
        (gnosis-agent--launch record)
        (should-not gnosis-db))
      (should (equal "unfinished" (plist-get (gnosis-agent-status session) :status)))
      (gnosis-agent-resume session)
      (let ((gnosis-dir (make-temp-name "/tmp/other-gnosis-")))
        (gnosis-agent--launch (car gnosis-agent--launches)))
      (should (equal "unfinished" (plist-get (gnosis-agent-status session) :status)))
      (gnosis-agent-resume session)
      (let ((gnosis-review--running "another"))
        (should-error (gnosis-agent-cancel session))
        (gnosis-agent--launch (car gnosis-agent--launches)))
      (should (equal "unfinished" (plist-get (gnosis-agent-status session) :status)))
      (gnosis-agent-resume session)
      (let (escaped)
        (cl-letf (((symbol-function 'gnosis--read-string-with-input-method)
                   (lambda (&rest _) (signal 'quit nil))))
          (condition-case nil (gnosis-agent--launch (car gnosis-agent--launches))
            (quit (setq escaped t))))
        (should-not escaped))
      (should-not (gnosis-select '* 'practice-events))
      (should (equal "unfinished" (plist-get (gnosis-agent-status session) :status))))))

