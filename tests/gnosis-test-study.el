(ert-deftest gnosis-study-action-owned-mutations-and-cancel ()
  (dolist (mode '(due practice))
    (dolist (action '(?d ?s ?f))
      (dolist (answer (if (= action ?f) '(t) '(nil quit t)))
        (gnosis-test-study
          (gnosis-test-study-view-fixture "Encountered")
          (gnosis-study-flag 42 t)
          (let ((gnosis-review-basic-input 'typed) before)
            (cl-letf (((symbol-function 'gnosis--read-string-with-input-method)
                       (lambda (&rest _) "Answer"))
                      ((symbol-function 'read-char-choice)
                       (lambda (&rest _)
                         (if before (signal 'quit nil)
                           (setq before (gnosis-test-study-view-snapshot)) action)))
                      ((symbol-function 'y-or-n-p)
                       (lambda (&rest _) (if (eq answer 'quit) (signal 'quit nil) answer))))
              (condition-case nil (gnosis-review-loop '(42) mode) (quit nil)))
            (if (not (eq answer t))
                (should (equal before (gnosis-test-study-view-snapshot)))
              (pcase action
                (?d (should-not (gnosis-get 'id 'themata '(= id 42)))
                    (should (equal '(42) (gnosis-review-state-skipped (gnosis-review--read-session)))))
                (?s (should (gnosis-suspended-p 42)))
                (?f (should (member "needs_work" (gnosis-get-tags-for-ids '(42)))))))
            (should (gnosis-get 'id 'themata '(= id 43)))
            (should-not (gnosis-select '* 'review-events))
            (should-not (gnosis-select '* 'practice-events))))))))


