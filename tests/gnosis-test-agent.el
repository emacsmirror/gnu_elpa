(ert-deftest gnosis-agent-native-suspend-settles-required-continuation ()
  (dolist (case '(("wrong" nil "excluded")
                  ("a" (:successes-required 2) "excluded")
                  ("a" nil "target-reached")
                  ("wrong" (:max-attempts-per-thema 1) "attempt-limit")))
    (gnosis-test-agent
      (gnosis-test--add-basic-thema "A" "a" nil nil 101)
      (gnosis-scheduler-accept-review (gnosis-scheduler-event-id) 101 'success
                                     1780000000000000 (gnosis--today-int))
      (let* ((session (gnosis-test-agent-start '(101) (nth 1 case)))
             (choices (list ?s ?n))
             before)
        (cl-letf (((symbol-function 'gnosis--read-string-with-input-method)
                   (lambda (&rest _) (car case)))
                  ((symbol-function 'gnosis-review--read-action)
                   (lambda (&rest _)
                     (when (equal choices '(?n))
                       ;; Suspension is intentional; acceptance must not reschedule.
                       (setq before (gnosis-test-agent-snapshot)))
                     (or (pop choices) (ert-fail "Unexpected extra presentation"))))
                  ((symbol-function 'y-or-n-p) (lambda (&rest _) t)))
          (gnosis-agent--launch (car gnosis-agent--launches)))
        (should-not choices)
        (should (equal before (gnosis-test-agent-snapshot)))
        (let* ((result (gnosis-agent-results session))
               (summary (plist-get result :summary))
               (item (aref (plist-get result :items) 0))
               (excluded (if (equal (nth 2 case) "excluded") 1 0)))
          (should (equal "completed" (plist-get result :status)))
          (should (equal [] (plist-get result :remaining-ids)))
          (should (equal (nth 2 case) (plist-get item :reason)))
          (should (= excluded (plist-get (plist-get result :targets) :excluded)))
          (should (= 0 (plist-get (plist-get result :targets) :unfinished)))
          (should (= excluded (plist-get summary :excluded)))
          (should (= 1 (plist-get summary :attempts)))
          (should (= 0 (plist-get summary :unattempted)))
          (should (= 1 (length (plist-get item :events))))
          (should (equal (if (equal (car case) "a") "success" "failure")
                         (plist-get (aref (plist-get item :events) 0) :outcome)))
          (should (eq t (plist-get (aref (plist-get item :events) 0) :effective)))
          (gnosis-sqlite-close gnosis-db)
          (setq gnosis-db (gnosis-sqlite-open gnosis-test--db-file))
          (gnosis-update 'scheduler-state '(= suspended 0) '(= thema-id 101))
          (should (equal result (gnosis-agent-results session)))
          (gnosis-test-agent-start '(101))
          (should (equal result (gnosis-agent-results session))))))))

(ert-deftest gnosis-agent-exclusion-checkpoint-atomicity-and-undo ()
  (gnosis-test-agent
    (gnosis-test--add-basic-thema "A" "a" nil nil 101)
    (let ((session (gnosis-test-agent-start '(101))))
      (gnosis-update 'scheduler-state '(= suspended 1) '(= thema-id 101))
      (let ((before (gnosis-agent-results session))
            (checkpoint (gnosis-review--state-data (gnosis-review--read-session))))
        ;; Merely suspending does not rewrite history or settle a queued item.
        (should (= 0 (plist-get (plist-get before :targets) :excluded)))
        (cl-letf (((symbol-function 'gnosis-review--save-history)
                   (lambda (_) (error "History disk fault"))))
          (should-error (gnosis-test-agent-grade nil)))
        (should (equal before (gnosis-agent-results session)))
        (should (equal checkpoint (gnosis-review--state-data (gnosis-review--read-session))))
        (should-not (gnosis-select '* 'practice-events)))
      (gnosis-test-agent-grade nil)
      (should (= 1 (plist-get (plist-get (gnosis-agent-results session) :targets) :excluded)))
      (gnosis-review-undo)
      (let* ((result (gnosis-agent-results session))
             (item (aref (plist-get result :items) 0)))
        (should (equal [101] (plist-get result :remaining-ids)))
        (should (equal "unfinished" (plist-get item :reason)))
        (should (= 0 (plist-get item :attempts)))
        (should (= 1 (length (plist-get item :events))))
        (should (eq :false (plist-get (aref (plist-get item :events) 0) :effective)))))))

(ert-deftest gnosis-agent-ordinary-practice-suspend-summary ()
