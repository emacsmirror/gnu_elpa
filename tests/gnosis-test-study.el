(defun gnosis-test-study-reject-alternate-replacement (table migrated)
  "Check TABLE alternate-key replacement and hard deletion after MIGRATED setup."
  (gnosis-test-with-old-db
    (when migrated
      (gnosis-test--create-v9-schema)
      (should (= 9 (gnosis--db-version))))
    (gnosis-db-init)
    (should (= gnosis-db-version (gnosis--db-version)))
    ;; REPLACE must be rejected without depending on recursive delete triggers.
    (gnosis-sqlite-execute gnosis-db "PRAGMA recursive_triggers = OFF")
    (should (equal '((0)) (gnosis-sqlite-select gnosis-db "PRAGMA recursive_triggers")))
    (let ((id (gnosis-test--add-basic-thema "Q" "A")))
      (gnosis-scheduler-accept-review (make-string 64 ?a) id 'success 100 20260907)
      (gnosis-sqlite-execute gnosis-db
        "INSERT INTO practice_events VALUES ('practice-old', ?, 'session', 1, 100, 3)"
        (list id))
      (gnosis-sqlite-execute gnosis-db
        "INSERT INTO practice_voids VALUES ('practice-correction', 'practice-old')")
      (gnosis-sqlite-execute gnosis-db
        "INSERT INTO review_voids SELECT 'review-correction', event_id FROM review_events")
      (let* ((tables '(review_events review_voids practice_events practice_voids))
             (snapshot (lambda ()
                         (mapcar (lambda (name)
                                   (gnosis-sqlite-select gnosis-db
                                     (format "SELECT * FROM %s ORDER BY 1" name)))
                                 tables)))
             (before (funcall snapshot))
             (schedule (gnosis-test-study-snapshot)))
        (should (seq-every-p #'consp before))
        (should-error
         (gnosis-sqlite-execute gnosis-db
           (pcase-exhaustive table
             ('practice_events
              "INSERT OR REPLACE INTO practice_events
               SELECT 'practice-new', thema_id, session_id, attempt, 200, 1
                 FROM practice_events WHERE event_id = 'practice-old'")
             ('practice_voids
              "INSERT OR REPLACE INTO practice_voids
               VALUES ('practice-correction-new', 'practice-old')")
             ('review_voids
              "INSERT OR REPLACE INTO review_voids
               SELECT 'review-correction-new', event_id FROM review_events")))
         :type 'sqlite-error)
        (should (equal before (funcall snapshot)))
        (should (equal schedule (gnosis-test-study-snapshot)))
        (gnosis--delete 'themata `(= id ,id))
        (should-not (gnosis-select '* 'themata))
        (should (seq-every-p #'null (funcall snapshot)))
        (should-not (gnosis-sqlite-select gnosis-db "PRAGMA foreign_key_check"))))))

